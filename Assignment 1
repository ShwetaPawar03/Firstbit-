//1. Check Whether a Number is Even or Odd
#include<stdio.h>
void main()
{
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(n % 2 == 0)
    {
        printf("Even Number");
    }
    else
    {
        printf("Odd Number");
    }
}

//2. Check Given 3-Digit Number is Palindrome or Not

#include<stdio.h>
void main()
{
    int n, rev = 0, rem, temp;

    printf("Enter 3 digit number: ");
    scanf("%d", &n);

    temp = n;

    while(n > 0)
    {
        rem = n % 10;
        rev = rev * 10 + rem;
        n = n / 10;
    }

    if(temp == rev)
    {
        printf("Palindrome Number");
    }
    else
    {
        printf("Not Palindrome Number");
    }
}

//3. Check Whether a Given Year is Leap Year or Not

