
#include <stdio.h>

void main()
{
    int n, i, j, temp, digit;
    int sum, fact, arm, count;
    int start, end;
    int choice, num, rev, rem;
    
    // 1. Print Armstrong Numbers in Range

    printf("\n1. Armstrong Numbers");
    printf("\nEnter start and end: ");
    scanf("%d %d", &start, &end);

    for(i = start; i <= end; i++)
    {
        temp = i;
        count = 0;

        while(temp > 0)
        {
            count++;
            temp = temp / 10;
        }

        temp = i;
        arm = 0;

        while(temp > 0)
        {
            digit = temp % 10;
            fact = 1;

            for(j = 1; j <= count; j++)
            {
                fact = fact * digit;
            }

            arm = arm + fact;
            temp = temp / 10;
        }

        if(arm == i)
        {
            printf("%d ", i);
        }
    }


    // 2. Print Prime Numbers in Range

    printf("\n\n2. Prime Numbers");
    printf("\nEnter start and end: ");
    scanf("%d %d", &start, &end);

    for(i = start; i <= end; i++)
    {
        count = 0;

        for(j = 1; j <= i; j++)
        {
            if(i % j == 0)
            {
                count++;
            }
        }

        if(i > 1 && count == 2)
        {
            printf("%d ", i);
        }
    }


    // 3. Print Perfect Numbers in Range

    printf("\n\n3. Perfect Numbers");
    printf("\nEnter start and end: ");
    scanf("%d %d", &start, &end);

    for(i = start; i <= end; i++)
    {
        sum = 0;

        for(j = 1; j < i; j++)
        {
            if(i % j == 0)
            {
                sum = sum + j;
            }
        }

        if(i > 0 && sum == i)
        {
            printf("%d ", i);
        }
    }


    // 4. Print Strong Numbers in Range

    printf("\n\n4. Strong Numbers");
    printf("\nEnter start and end: ");
    scanf("%d %d", &start, &end);

    for(i = start; i <= end; i++)
    {
        temp = i;
        sum = 0;

        while(temp > 0)
        {
            digit = temp % 10;
            fact = 1;

            for(j = 1; j <= digit; j++)
            {
                fact = fact * j;
            }

            sum = sum + fact;
            temp = temp / 10;
        }

        if(i >= 0 && sum == i)
        {
            printf("%d ", i);
        }
    }


    // 5. Menu Driven Program

    printf("\n\n5. MENU DRIVEN PROGRAM");

    printf("\nEnter a number: ");
    scanf("%d", &num);

    printf("\n1. Even or Odd");
    printf("\n2. Prime or Not");
    printf("\n3. Palindrome or Not");
    printf("\n4. Positive, Negative or Zero");
    printf("\n5. Reverse a Number");
    printf("\n6. Sum of Digits");

    printf("\nEnter your choice: ");
    scanf("%d", &choice);


    switch(choice)
    {
        case 1:

            if(num % 2 == 0)
                printf("Even Number");
            else
                printf("Odd Number");

            break;


        case 2:

            count = 0;

            for(i = 1; i <= num; i++)
            {
                if(num % i == 0)
                {
                    count++;
                }
            }

            if(num > 1 && count == 2)
                printf("Prime Number");
            else
                printf("Not Prime Number");

            break;


        case 3:

            temp = num;
            rev = 0;

            while(temp > 0)
            {
                rem = temp % 10;
                rev = rev * 10 + rem;
                temp = temp / 10;
            }

            if(num >= 0 && rev == num)
                printf("Palindrome Number");
            else
                printf("Not Palindrome Number");

            break;


        case 4:

            if(num > 0)
                printf("Positive Number");
            else if(num < 0)
                printf("Negative Number");
            else
                printf("Zero");

            break;


        case 5:

            temp = num;
            rev = 0;

            while(temp > 0)
            {
                rem = temp % 10;
                rev = rev * 10 + rem;
                temp = temp / 10;
            }

            printf("Reverse = %d", rev);

            break;


        case 6:

            temp = num;
            sum = 0;

            while(temp > 0)
            {
                digit = temp % 10;
                sum = sum + digit;
                temp = temp / 10;
            }

            printf("Sum of Digits = %d", sum);

            break;


        default:

            printf("Invalid Choice");

    }

}
