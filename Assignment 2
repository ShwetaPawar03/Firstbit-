//5. Calculate Discount Based on Student and Purchase Amount

#include<stdio.h>
void main()
{
    float price, discount, total;
    char ch;

    printf("Enter purchase price: ");
    scanf("%f", &price);

    printf("Are you a student? (y/n): ");
    scanf(" %c", &ch);

    if(ch == 'y' || ch == 'Y')
    {
        if(price > 500)
        {
            discount = price * 20 / 100;
        }
        else
        {
            discount = price * 10 / 100;
        }
    }
    else if(ch == 'n' || ch == 'N')
    {
        if(price > 600)
        {
            discount = price * 15 / 100;
        }
        else
        {
            discount = 0;
        }
    }
    else
    {
        printf("Invalid Choice");
        return;
    }

    total = price - discount;

    printf("Discount = %.2f\n", discount);
    printf("Final Price = %.2f", total);
}

//6. Check Whether a Number is Divisible by 3, 5 or Both

#include<stdio.h>
void main()
{
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(n % 3 == 0 && n % 5 == 0)
    {
        printf("Divisible by both");
    }
    else if(n % 3 == 0)
    {
        printf("Divisible by 3 but not by 5");
    }
    else if(n % 5 == 0)
    {
        printf("Divisible by 5 but not by 3");
    }
    else
    {
        printf("Divisible by None");
    }
}

7. Check Person's Age Category

#include<stdio.h>
void main()
{
    int age;

    printf("Enter your age: ");
    scanf("%d", &age);

    if(age < 0)
    {
        printf("Invalid Age");
    }
    else if(age < 12)
    {
        printf("Child");
    }
    else if(age <= 19)
    {
        printf("Teenager");
    }
    else if(age <= 59)
    {
        printf("Adult");
    }
    else
    {
        printf("Senior");
    }
}