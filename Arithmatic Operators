//7.write a program  to convert given minutes into hours and remaining minutes .

void main()
{
    int minutes = 135;
    int hours, remaining;

    hours = minutes / 60;
    remaining = minutes % 60;

    printf("Hours = %d\n", hours);
    printf("Remaining Minutes = %d", remaining);

    return 0;
}

//8.write a C program to input the length  and width of a rectangle and finds its parameter .

void main()
{
    int length, width, perimeter;

    printf("Enter length: ");
    scanf("%d", &length);

    printf("Enter width: ");
    scanf("%d", &width);

    perimeter = 2 * (length + width);

    printf("Perimeter = %d", perimeter);

    return 0;
}

//9.write a C program to input a base and height of a triangle and calculate its area . 

void main()
{
    float base, height, area;

    printf("Enter base: ");
    scanf("%f", &base);

    printf("Enter height: ");
    scanf("%f", &height);

    area = 0.5 * base * height;

    printf("Area of Triangle = %f", area);

    return 0;
}

//10. write a c program to input marks of five subjects find the total marks and calculate the percentage .

void main()
{
    int m1, m2, m3, m4, m5, total;
    float percentage;

    printf("Enter marks of five subjects: ");
    scanf("%d %d %d %d %d", &m1, &m2, &m3, &m4, &m5);

    total = m1 + m2 + m3 + m4 + m5;
    percentage = (total / 500.0) * 100;

    printf("Total Marks = %d\n", total);
    printf("Percentage = %.2f%%", percentage);

    return 0;
}